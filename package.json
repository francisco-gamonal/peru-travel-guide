{
  "name": "astro-travel-guide",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": "10.33.4"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "preview:e2e": "pnpm build && astro preview --host 127.0.0.1 --port 4321",
    "astro": "astro",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage src/lib",
    "test:static": "vitest run src/test/static-destinations.test.ts",
    "test:e2e": "playwright test",
    "test:verify:push": "pnpm build && pnpm lint && pnpm spec:traceability && pnpm test:coverage && pnpm test:static",
    "test:verify": "pnpm build && pnpm lint && pnpm spec:traceability && pnpm test:coverage && pnpm test:static && pnpm test:e2e",
    "spec:traceability": "node scripts/verify-spec-traceability.mjs",
    "spec:review-gate": "node scripts/verify-review-gate.mjs",
    "lhci": "node scripts/run-lhci.mjs",
    "changelog:generate": "node scripts/generate-changelog.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.0",
    "astro": "6.3.7",
    "tailwindcss": "4.3.0"
  },
  "devDependencies": {
    "@lhci/cli": "^0.14.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.1",
    "eslint-plugin-astro": "^1.5.0",
    "husky": "^9.1.7",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.18"
  }
}
