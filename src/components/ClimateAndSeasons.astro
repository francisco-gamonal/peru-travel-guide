---
import { buildClimateWidgetView } from '../lib/climate';
import type { ClimateDestination } from '../types/climate';

interface Props {
	climate: ClimateDestination | null;
	cityName: string;
}

const { climate, cityName } = Astro.props;
const view = climate ? buildClimateWidgetView(climate) : null;
---

<section class="flex flex-col gap-4" aria-labelledby="climate-heading">
	{
		view ? (
			<article class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
				<header class="border-b border-slate-100 pb-4">
					<h2 id="climate-heading" class="text-xl font-semibold text-slate-900">
						Clima y mejores épocas
					</h2>
					<p class="mt-2 text-slate-700">{view.summary}</p>
					<p class="mt-1 text-sm text-slate-500">
						Referencia orientativa para planificar tu viaje a {cityName}; no sustituye el
						pronóstico en tiempo real.
					</p>
				</header>

				<div class="mt-4">
					<h3 class="text-sm font-semibold uppercase tracking-wide text-slate-600">
						Estaciones
					</h3>
					<div class="mt-3 overflow-x-auto">
						<table class="w-full min-w-[280px] text-sm text-slate-700">
							<caption class="sr-only">Estaciones climáticas de {cityName}</caption>
							<thead>
								<tr class="border-b border-slate-200 text-left text-xs font-medium uppercase tracking-wide text-slate-500">
									<th scope="col" class="pb-2 pr-3">Estación</th>
									<th scope="col" class="pb-2 pr-3">Temperatura</th>
									<th scope="col" class="pb-2">Lluvia</th>
								</tr>
							</thead>
							<tbody>
								{view.seasons.map((season) => (
									<>
										<tr class="border-t border-slate-100 first:border-t-0">
											<th
												scope="row"
												class="py-2 pr-3 align-top font-medium text-slate-900"
											>
												{season.name}
											</th>
											<td class="py-2 pr-3 align-top tabular-nums">{season.tempRangeC}</td>
											<td class="py-2 align-top">{season.rainfall}</td>
										</tr>
										<tr class="border-b border-slate-50">
											<td colspan="3" class="pb-3 text-slate-600">
												{season.description}
											</td>
										</tr>
									</>
								))}
							</tbody>
						</table>
					</div>
				</div>

				<div class="mt-5 rounded-lg bg-emerald-50/60 px-4 py-3">
					<h3 class="text-sm font-semibold uppercase tracking-wide text-emerald-950">
						Mejores épocas para viajar
					</h3>
					<ul class="mt-2 flex flex-col gap-2" role="list">
						{view.bestTimes.map((window) => (
							<li class="text-sm">
								<p class="font-medium text-emerald-950">{window.label}</p>
								<p class="text-emerald-900/80">
									Meses: {window.monthsFormatted}
									<span class="text-slate-600"> · {window.reason}</span>
								</p>
							</li>
						))}
					</ul>
				</div>

				<footer class="mt-5 border-t border-slate-100 pt-4">
					<p class="text-xs font-medium text-slate-600">Fuente climática</p>
					<p class="mt-1 text-xs text-slate-500">
						{view.sourceFooter.sourceUrl ? (
							<a
								href={view.sourceFooter.sourceUrl}
								class="text-sky-700 underline hover:text-sky-900"
								rel="noopener noreferrer"
							>
								{view.sourceFooter.source}
							</a>
						) : (
							<span>{view.sourceFooter.source}</span>
						)}
						<span> · {view.sourceFooter.year}</span>
					</p>
				</footer>
			</article>
		) : (
			<article class="rounded-xl border border-dashed border-slate-300 bg-slate-50 p-5">
				<h2 id="climate-heading" class="text-xl font-semibold text-slate-900">
					Clima y mejores épocas
				</h2>
				<p class="mt-2 text-slate-600">
					Aún no tenemos datos climáticos curados para {cityName}. Vuelve pronto o elige otro
					destino.
				</p>
			</article>
		)
	}
</section>
