---
import type { ClimateDestination } from '../types/climate';
import { formatMonthRange } from '../lib/climate';
import SourceAttribution from './SourceAttribution.astro';

interface Props {
	climate: ClimateDestination | null;
	cityName: string;
}

const { climate, cityName } = Astro.props;
---

<section class="flex flex-col gap-6" aria-labelledby="climate-heading">
	{
		climate ? (
			<>
				<div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
					<h2 id="climate-heading" class="text-xl font-semibold text-slate-900">
						Clima y mejores épocas
					</h2>
					<p class="mt-2 text-slate-700">{climate.summary}</p>
					<p class="mt-1 text-sm text-slate-500">
						Referencia orientativa para planificar tu viaje a {cityName}; no sustituye el
						pronóstico en tiempo real.
					</p>
				</div>

				<div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
					<h3 class="text-lg font-medium text-slate-900">Estaciones</h3>
					<ul class="mt-3 flex flex-col gap-3" role="list">
						{climate.seasons.map((season) => (
							<li class="border-t border-slate-100 pt-3 first:border-t-0 first:pt-0">
								<p class="font-medium text-slate-900">{season.name}</p>
								<p class="text-sm text-slate-600">
									{season.tempRangeC} · {season.rainfall}
								</p>
								<p class="mt-1 text-slate-700">{season.description}</p>
							</li>
						))}
					</ul>
				</div>

				<div class="rounded-xl border border-emerald-800/10 bg-emerald-50/50 p-5 shadow-sm">
					<h3 class="text-lg font-medium text-emerald-950">Mejores épocas para viajar</h3>
					<ul class="mt-3 flex flex-col gap-4" role="list">
						{climate.bestTimeToVisit.map((window) => (
							<li>
								<p class="font-medium text-emerald-950">{window.label}</p>
								<p class="text-sm text-emerald-900/80">
									Meses: {formatMonthRange(window.months)}
								</p>
								<p class="mt-1 text-slate-700">{window.reason}</p>
							</li>
						))}
					</ul>
				</div>

				<SourceAttribution
					source={climate.source}
					year={climate.year}
					sourceUrl={climate.sourceUrl}
				/>
			</>
		) : (
			<div class="rounded-xl border border-dashed border-slate-300 bg-slate-50 p-5">
				<h2 id="climate-heading" class="text-xl font-semibold text-slate-900">
					Clima y mejores épocas
				</h2>
				<p class="mt-2 text-slate-600">
					Aún no tenemos datos climáticos curados para {cityName}. Vuelve pronto o elige otro
					destino.
				</p>
			</div>
		)
	}
</section>
