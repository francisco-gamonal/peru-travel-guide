---
import DestinationSelect from './DestinationSelect.astro';
import PopulationComparison from './PopulationComparison.astro';
import type { Destination, PeruReference } from '../types/population';

interface Props {
	destination: Destination;
	destinations: Destination[];
	references: PeruReference[];
}

const { destination, destinations, references } = Astro.props;
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta
			name="description"
			content={`Compara la población de ${destination.cityName} con Perú, Lima y distritos de Lima.`}
		/>
		<meta name="generator" content={Astro.generator} />
		<title>
			{destination.cityName} vs Perú y Lima — Comparación poblacional
		</title>
	</head>
	<body class="min-h-screen bg-slate-50 text-slate-900 antialiased">
		<main class="mx-auto flex max-w-2xl flex-col gap-8 px-6 py-12">
			<header class="flex flex-col gap-3">
				<p class="text-sm font-medium uppercase tracking-wide text-sky-700">Guía personal de viaje</p>
				<h1 class="text-3xl font-bold leading-tight">¿Qué tan grande es tu destino?</h1>
				<p class="text-lg text-slate-700">
					Compara la escala humana de una ciudad y su país con el referente que ya conoces:
					<strong>Perú</strong>, la <strong>provincia de Lima</strong> y distritos de Lima.
				</p>
			</header>

			<DestinationSelect destinations={destinations} currentId={destination.id} />

			<PopulationComparison destination={destination} references={references} />

			<p class="text-sm text-slate-500">
				Próximamente: clima, cultura y mejores épocas para viajar (siguientes fases del roadmap).
			</p>
		</main>
	</body>
</html>
