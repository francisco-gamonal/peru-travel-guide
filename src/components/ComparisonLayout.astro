---
import ClimateAndSeasons from './ClimateAndSeasons.astro';
import CultureGuide from './CultureGuide.astro';
import DestinationFlag from './DestinationFlag.astro';
import DestinationSelect from './DestinationSelect.astro';
import PopulationComparison from './PopulationComparison.astro';
import type { ClimateDestination } from '../types/climate';
import type { CultureDestination } from '../types/culture';
import type { Destination, PeruReference } from '../types/population';

interface Props {
	destination: Destination;
	destinations: Destination[];
	references: PeruReference[];
	climate: ClimateDestination | null;
	culture: CultureDestination | null;
}

const { destination, destinations, references, climate, culture } = Astro.props;
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta
			name="description"
			content={`Guía personal de ${destination.cityName}: población con Perú y Lima, clima, mejores épocas y consejos culturales para viajar.`}
		/>
		<meta name="generator" content={Astro.generator} />
		<title>
			{destination.cityName} — Guía de población, clima y cultura
		</title>
	</head>
	<body class="min-h-screen bg-slate-50 text-slate-900 antialiased">
		<main class="mx-auto flex max-w-2xl flex-col gap-8 px-6 py-12">
			<header class="flex flex-col gap-3">
				<p class="text-sm font-medium uppercase tracking-wide text-sky-700">Guía personal de viaje</p>
				<div class="flex items-start gap-3">
					<DestinationFlag
						countryCode={destination.countryCode}
						countryName={destination.countryName}
						size="md"
						loading="eager"
						fetchpriority="high"
					/>
					<h1 class="text-3xl font-bold leading-tight">Tu guía para {destination.cityName}</h1>
				</div>
				<p class="text-lg text-slate-700">
					Compara la escala humana con <strong>Perú</strong> y <strong>Lima</strong>, planifica el
					clima y las mejores épocas, y conoce consejos culturales para tu viaje.
				</p>
			</header>

			<DestinationSelect destinations={destinations} currentId={destination.id} />

			<PopulationComparison destination={destination} references={references} />

			<ClimateAndSeasons climate={climate} cityName={destination.cityName} />

			<CultureGuide culture={culture} cityName={destination.cityName} />
		</main>
	</body>
</html>
