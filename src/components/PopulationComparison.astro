---
import {
	barWidthPercent,
	buildComparisonRows,
	formatPopulation,
	getLimaProvinceReference,
	ratioLabel,
} from '../lib/population';
import type { Destination, PeruReference } from '../types/population';
import SourceAttribution from './SourceAttribution.astro';

interface Props {
	destination: Destination;
	references: PeruReference[];
}

const { destination, references } = Astro.props;
const limaProvince = getLimaProvinceReference(references);
const rows = buildComparisonRows(destination, references);
const maxPopulation = Math.max(...rows.map((row) => row.population));
const cityRatioSentence = ratioLabel(
	`${destination.cityName} (ciudad)`,
	destination.cityPopulation,
	limaProvince.name,
	limaProvince.population,
);
---

<section class="flex flex-col gap-6" aria-labelledby="comparison-heading">
	<div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
		<h2 id="comparison-heading" class="text-xl font-semibold text-slate-900">
			{destination.cityName}, {destination.countryName}
		</h2>
		<p class="mt-2 text-slate-700">{cityRatioSentence}</p>
		<p class="mt-1 text-sm text-slate-500">
			Cifras aproximadas según fuentes públicas; úsalas como referencia de escala humana, no como dato
			oficial en tiempo real.
		</p>
	</div>

	<ul class="flex flex-col gap-4" role="list">
		{
			rows.map((row) => {
				const width = barWidthPercent(row.population, maxPopulation);
				const barLabel = `${row.label}: ${formatPopulation(row.population)} habitantes`;
				return (
					<li class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
						<div class="mb-2 flex flex-wrap items-baseline justify-between gap-2">
							<h3 class="font-medium text-slate-900">{row.label}</h3>
							<p class="text-lg font-semibold tabular-nums text-sky-800">
								{formatPopulation(row.population)}
							</p>
						</div>
						<div
							class="h-3 w-full overflow-hidden rounded-full bg-slate-100"
							role="img"
							aria-label={barLabel}
						>
							<div
								class="h-full rounded-full bg-sky-600 transition-all"
								style={`width: ${width}%`}
							/>
						</div>
						<div class="mt-2">
							<SourceAttribution
								source={row.source}
								year={row.year}
								sourceUrl={row.sourceUrl}
							/>
						</div>
					</li>
				);
			})
		}
	</ul>
</section>
