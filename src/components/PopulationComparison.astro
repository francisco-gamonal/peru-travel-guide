---
import PopulationBarRow from './PopulationBarRow.astro';
import { buildPopulationComparisonView, formatPopulation } from '../lib/population';
import type { Destination, PeruReference } from '../types/population';

interface Props {
	destination: Destination;
	references: PeruReference[];
}

const { destination, references } = Astro.props;
const view = buildPopulationComparisonView(destination, references);
---

<section class="flex flex-col gap-4" aria-labelledby="comparison-heading">
	<article class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
		<header class="border-b border-slate-100 pb-4">
			<h2 id="comparison-heading" class="text-xl font-semibold text-slate-900">
				{view.destinationTitle}
			</h2>
			<p class="mt-2 text-slate-700">{view.cityRatioSentence}</p>
			<p class="mt-1 text-sm text-slate-500">
				Cifras aproximadas según fuentes públicas; úsalas como referencia de escala humana.
			</p>
		</header>

		<div class="mt-4 flex flex-col gap-5">
			<div>
				<h3 class="text-sm font-semibold uppercase tracking-wide text-slate-600">Por país</h3>
				<ul class="mt-3 flex flex-col gap-3" role="list">
					{view.countryBars.map((bar) => (
						<PopulationBarRow bar={bar} />
					))}
				</ul>
			</div>

			<div>
				<h3 class="text-sm font-semibold uppercase tracking-wide text-slate-600">Por ciudad</h3>
				<ul class="mt-3 flex flex-col gap-3" role="list">
					{view.cityBars.map((bar) => (
						<PopulationBarRow bar={bar} />
					))}
				</ul>
				{
					view.districts.length > 0 && (
						<ul
							class="mt-3 grid gap-1 border-t border-slate-100 pt-3 text-sm text-slate-700 sm:grid-cols-2"
							role="list"
							aria-label="Distritos de Lima"
						>
							{view.districts.map((district) => (
								<li class="flex justify-between gap-2">
									<span>{district.name}</span>
									<span class="tabular-nums text-slate-900">
										{formatPopulation(district.population)}
									</span>
								</li>
							))}
						</ul>
					)
				}
			</div>
		</div>

		<footer class="mt-5 border-t border-slate-100 pt-4">
			<p class="text-xs font-medium text-slate-600">Fuentes</p>
			<ul class="mt-1 flex flex-col gap-1 text-xs text-slate-500" role="list">
				{
					view.sourcesFooter.map((item) => (
						<li>
							{item.sourceUrl ? (
								<a
									href={item.sourceUrl}
									class="text-sky-700 underline hover:text-sky-900"
									rel="noopener noreferrer"
								>
									{item.source}
								</a>
							) : (
								<span>{item.source}</span>
							)}
							<span> · {item.year}</span>
						</li>
					))
				}
			</ul>
		</footer>
	</article>
</section>
