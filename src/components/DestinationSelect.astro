---
import DestinationFlag from './DestinationFlag.astro';
import type { Destination } from '../types/population';

interface Props {
	destinations: Destination[];
	currentId: string;
}

const { destinations, currentId } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<nav aria-label="Elige un destino" class="flex flex-col gap-2">
	<p id="destination-label" class="text-sm font-medium text-slate-700">
		Elige un destino
	</p>
	<ul
		role="listbox"
		aria-labelledby="destination-label"
		class="flex flex-col gap-1 rounded-lg border border-slate-200 bg-white p-1 shadow-sm sm:max-w-md"
	>
		{
			destinations.map((destination) => {
				const selected = destination.id === currentId;
				const href = `${base}destino/${destination.id}/`;
				return (
					<li role="presentation">
						<a
							role="option"
							href={href}
							aria-selected={selected}
							aria-current={selected ? 'page' : undefined}
							class:list={[
								'flex items-center gap-2 rounded-md px-3 py-2 text-sm text-slate-900 no-underline transition-colors',
								selected
									? 'bg-sky-50 font-medium text-sky-900 ring-2 ring-sky-200'
									: 'hover:bg-slate-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-500',
							]}
						>
							<DestinationFlag
								countryCode={destination.countryCode}
								countryName={destination.countryName}
								size="sm"
								loading="lazy"
							/>
							<span>
								{destination.cityName}, {destination.countryName}
							</span>
						</a>
					</li>
				);
			})
		}
	</ul>
</nav>
